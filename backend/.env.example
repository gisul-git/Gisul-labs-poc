PORT=5000
NODE_ENV=development

# Proxmox
PROXMOX_HOST=https://your-proxmox-host:8006
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=your-password
PROXMOX_NODE=pve
# OR use API token instead of user/pass:
# PROXMOX_TOKEN_ID=root@pam!mytoken
# PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# Admin user (for demo — replace with DB in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/gisul-labs?retryWrites=true&w=majority

# WinRM (Windows VM credentials)
WINRM_USERNAME=Administrator
WINRM_PASSWORD=YourPassword
WINRM_PORT=5985

# Seed script — set to the VMID of your Windows template
SEED_TEMPLATE_ID=100
